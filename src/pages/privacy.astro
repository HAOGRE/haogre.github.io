---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { normalizeLocale } from "@/i18n/locales";
import config from "@/config";

const locale = normalizeLocale(Astro.currentLocale ?? config.site.lang);
const privacy = await getEntry(
  "pages",
  locale === "en" ? "en/privacy" : "privacy"
);

if (!privacy) {
  throw new Error("Missing content entry: `privacy.md` or `en/privacy.md`");
}

const { Content } = await render(privacy);
---

<Layout
  title={`${privacy.data.title} | ${config.site.title}`}
  description={privacy.data.description}
  ogImage={privacy.data.ogImage}
  canonicalURL={privacy.data.canonicalURL}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={privacy.data.title} class="app-prose">
    <Content />
  </Main>
  <Footer />
</Layout>
